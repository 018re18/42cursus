# ---------------------------------------------------------------------------
# Inception - non-confidential configuration
# TEMPLATE: `make` copies it to srcs/.env (git-ignored) and fills in the
# login placeholders with LOGIN from the Makefile (override: make LOGIN=wil).
# Passwords are NOT stored here: they live in ../secrets/*.txt (git-ignored)
# and are handed to the containers as Docker secrets.
# ---------------------------------------------------------------------------

# 42 login (used for the domain name and the host data directory)
LOGIN=__LOGIN__
DOMAIN_NAME=__LOGIN__.42.fr

# Host directory backing the named volumes
DATA_PATH=/home/__LOGIN__/data

# MYSQL SETUP
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
# DB_HOST, not MYSQL_HOST: the mariadb client would pick MYSQL_HOST up from the
# environment and connect over TCP instead of the local socket.
DB_HOST=mariadb

# PORTS - change them here, then run `make` to rebuild and restart
NGINX_PORT=443
WP_PORT=9000
DB_PORT=3306

# WORDPRESS SETUP
WP_TITLE=Inception
WP_ADMIN_USER=siteowner
WP_ADMIN_EMAIL=siteowner@__LOGIN__.42.fr
WP_USER=writer
WP_USER_EMAIL=writer@__LOGIN__.42.fr
WP_USER_ROLE=author
