# ---------------------------------------------------------------------------
# Inception - non-confidential configuration
# Passwords are NOT stored here: they live in ../secrets/*.txt (git-ignored)
# and are handed to the containers as Docker secrets.
# ---------------------------------------------------------------------------

# 42 login (used for the domain name and the host data directory)
LOGIN=rookuma
DOMAIN_NAME=rookuma.42.fr

# Host directory backing the named volumes
DATA_PATH=/home/rookuma/data

# MYSQL SETUP
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_HOST=mariadb
MYSQL_PORT=3306

# WORDPRESS SETUP
WP_TITLE=Inception
WP_ADMIN_USER=siteowner
WP_ADMIN_EMAIL=siteowner@rookuma.42.fr
WP_USER=writer
WP_USER_EMAIL=writer@rookuma.42.fr
WP_USER_ROLE=author
